{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "backend/manage.py",
        "runserver",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "frontend-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--port",
        "5175",
        "--strictPort"
      ],
      "port": 5175
    },
    {
      "name": "frontend-dev2",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--port",
        "5177",
        "--strictPort"
      ],
      "port": 5177
    },
    {
      "name": "yukyu",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--prefix",
        "../yukyu",
        "wrangler",
        "dev",
        "--config",
        "../yukyu/wrangler.jsonc",
        "--port",
        "8790"
      ],
      "port": 8790
    },
    {
      "name": "biz-site",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--prefix",
        "../biz-site",
        "wrangler",
        "dev",
        "--config",
        "../biz-site/wrangler.jsonc",
        "--port",
        "8791"
      ],
      "port": 8791
    },
    {
      "name": "hojokin",
      "runtimeExecutable": "../hojokin_site/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8765",
        "-d",
        "../hojokin_site/dist"
      ],
      "port": 8765
    },
    {
      "name": "groundwork",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--prefix",
        "../groundwork",
        "wrangler",
        "dev",
        "--config",
        "../groundwork/wrangler.jsonc",
        "--port",
        "8792"
      ],
      "port": 8792
    }
  ]
}
